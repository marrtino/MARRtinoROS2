{
  "output_samplerate": 48000,
  "output_device_index": 1,
  "input_samplerate": 16000,
  "language": "it",
  "work_offline": true,
  "msg_start": "Ciao, sono pronta!",
  "wake_words": ["martino", "martina","marrtino"],
  "wake_match": "prefix",
  "case_sensitive": false,
  "normalize_accents": true,
  "beep": {
    "enabled": false,
    "frequency": 1000,
    "duration_ms": 180,
    "volume": 0.2
  },
  "msg_ack": "Ho capito",
  "tts_pre_audio_delay_ms": 200,
  "tts_anim_delay_ms": 0,

  "tts_special_gestures": {
    "enabled": true,
    "strip_emojis_from_tts": true,
    "max_events": 4,
    "rules": [
      {"token": "👋", "gesture": "hello",     "delay_ms": 0},
      {"token": "😊", "gesture": "happy",     "delay_ms": 120},
      {"token": "😜", "gesture": "playful",   "delay_ms": 180},
      {"token": "🤔", "gesture": "thinking",  "delay_ms": 220},
      {"token": "😮", "gesture": "surprised", "delay_ms": 140},
      {"token": "😅", "gesture": "shrug",     "delay_ms": 260}
    ]
  },
  "tts_pre_delay_ms": 200,
  "piper_models_dir": "/home/ubuntu/src/marrtinorobot2/marrtinorobot2_voice/models/piper",
  "piper_default_voice": "paola",
  "piper_length_scale": 1.3,
  "piper_noise_scale": 0.60,
  "piper_noise_w": 0.45,
  "debug": true
}
